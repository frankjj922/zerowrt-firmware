# 自定义配置，用于对固件进行最终的调整
# 这里添加的配置可以覆盖所有的配置

# --------------------------------------------------

# 示例:
# CONFIG_PACKAGE_luci-app-*=y

# --------------------------------------------------

# 基础工具
CONFIG_PACKAGE_naiveproxy=y
CONFIG_PACKAGE_btop=y
CONFIG_PACKAGE_automount=y

# LuCI 主题
CONFIG_PACKAGE_luci-theme-openmptcprouter=y
CONFIG_PACKAGE_luci-theme-routerich=y
CONFIG_PACKAGE_luci-theme-spectra=y
CONFIG_PACKAGE_luci-theme-openwrt=y
CONFIG_PACKAGE_luci-theme-material3=y
CONFIG_PACKAGE_luci-theme-alpha=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-edge=y
CONFIG_PACKAGE_luci-theme-design=y
CONFIG_PACKAGE_luci-theme-teleofis=y
CONFIG_PACKAGE_luci-theme-lightblue=y
CONFIG_PACKAGE_luci-theme-openwrt-2020=y
# iStoreOS 风格主题，实际包名为 luci-theme-opencash
CONFIG_PACKAGE_luci-theme-opencash=y

# LuCI 应用
CONFIG_PACKAGE_luci-app-parentcontrol=y
CONFIG_PACKAGE_luci-app-netdata=y
CONFIG_PACKAGE_luci-app-subconverter=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-ddns-go=y

# 互联网工具
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-app-openclash=y

# 其他常用组件
CONFIG_PACKAGE_netdata=y
CONFIG_PACKAGE_nginx=y
CONFIG_PACKAGE_nginx-mod-luci=y
CONFIG_PACKAGE_ipv6helper=y
